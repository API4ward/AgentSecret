#!/usr/bin/env bash
# Trusted launcher for the isolated deployment. Run it from the trusted host
# account that controls Docker; never from inside a worker.
#
#   guardctl up [--egress]          build and start the broker (and egress proxy)
#   guardctl broker ARGS...         trusted secret-guard CLI inside the broker domain
#   guardctl run OPTIONS -- CMD...  one task = one token = one worker container
#   guardctl down | destroy         stop (destroy also deletes vault and state)
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
project=${SG_PROJECT:-secret-guard}
state=/var/lib/secret-guard
compose=(docker compose -p "$project" -f "$here/compose.yaml")
if [ -n "${SG_COMPOSE_EXTRA:-}" ]; then
  compose+=(-f "$SG_COMPOSE_EXTRA")
fi

broker_cli() {
  "${compose[@]}" exec -T broker secret-guard --state "$state" "$@"
}

usage() {
  sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
  cat <<'EOF'

run options:
  --user USER --project PROJECT   task identity (required; set here, not by the agent)
  --agent NAME                    agent label recorded on the task (default: codex)
  --workspace DIR                 host directory mounted read-write at /workspace
  --image IMAGE                   worker image (default: secret-guard:isolated)
  --egress                        attach to the allow-list proxy instead of no network
  --env NAME=VALUE                extra worker environment (repeatable; never broker secrets)
EOF
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
  up)
    if [ "${1:-}" = "--egress" ]; then
      "${compose[@]}" --profile egress up -d --build --wait broker egress
    else
      "${compose[@]}" up -d --build --wait broker
    fi
    ;;
  down)
    "${compose[@]}" --profile egress down
    ;;
  destroy)
    "${compose[@]}" --profile egress down -v
    ;;
  broker)
    if [ -t 0 ]; then
      # secret-add reads the credential from a hidden prompt.
      "${compose[@]}" exec broker secret-guard --state "$state" "$@"
    else
      broker_cli "$@"
    fi
    ;;
  run)
    user="" task_project="" agent=codex workspace="" image=secret-guard:isolated egress=0
    extra_env=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --user) user=$2; shift 2 ;;
        --project) task_project=$2; shift 2 ;;
        --agent) agent=$2; shift 2 ;;
        --workspace) workspace=$2; shift 2 ;;
        --image) image=$2; shift 2 ;;
        --egress) egress=1; shift ;;
        --env) extra_env+=(-e "$2"); shift 2 ;;
        --) shift; break ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
      esac
    done
    if [ -z "$user" ] || [ -z "$task_project" ] || [ $# -eq 0 ]; then
      usage >&2
      exit 2
    fi

    name="run-$(date +%Y%m%d%H%M%S)-$$-$RANDOM"
    taskdir=/run/secret-guard/tasks/$name
    task_id=""
    cleanup() {
      # The task dies with its worker; a leaked token is useless afterwards.
      if [ -n "$task_id" ]; then
        broker_cli revoke task "$task_id" </dev/null >/dev/null 2>&1 || true
      fi
      "${compose[@]}" exec -T broker rm -rf "$taskdir" </dev/null >/dev/null 2>&1 || true
    }
    trap cleanup EXIT

    # </dev/null: stdin belongs to the worker command, not to these setup steps.
    "${compose[@]}" exec -T broker sh -c 'umask 027 && mkdir "$1"' sh "$taskdir" </dev/null
    created=$(broker_cli task-create --user "$user" --project "$task_project" --agent "$agent" --token-file "$taskdir/token" </dev/null)
    task_id=$(printf '%s' "$created" | sed -n 's/.*"task_id": *"\([^"]*\)".*/\1/p')
    "${compose[@]}" exec -T broker chmod 0440 "$taskdir/token" </dev/null

    args=(run --rm -i --name "sg-worker-$name"
      --user 10002:10002 --group-add 10003
      --read-only --cap-drop ALL --security-opt no-new-privileges --pids-limit 512
      --tmpfs /tmp:rw,nosuid,nodev,size=512m
      --tmpfs /home/worker:rw,nosuid,nodev,size=512m,uid=10002,gid=10002,mode=0700
      -e HOME=/home/worker
      -e SECRET_GUARD_URL=unix:///run/secret-guard/agent/agent.sock
      -e SECRET_GUARD_TOKEN_FILE=/run/secret-guard/task/token
      -e SECRET_GUARD_TASK_ID="$task_id"
      --mount "type=volume,src=${project}_sg-agent,dst=/run/secret-guard/agent,readonly"
      --mount "type=volume,src=${project}_sg-tasks,dst=/run/secret-guard/task,volume-subpath=$name,readonly")
    if [ -t 0 ] && [ -t 1 ]; then
      args+=(-t)
    fi
    if [ "$egress" = 1 ]; then
      args+=(--network "${project}_worker-net"
        -e HTTPS_PROXY=http://egress:8888 -e https_proxy=http://egress:8888)
    else
      args+=(--network none)
    fi
    if [ -n "$workspace" ]; then
      args+=(--mount "type=bind,src=$(cd "$workspace" && pwd),dst=/workspace" -w /workspace)
    fi
    if [ ${#extra_env[@]} -gt 0 ]; then
      args+=("${extra_env[@]}")
    fi
    # Not exec: the EXIT trap must revoke the task after the worker stops.
    docker "${args[@]}" "$image" "$@"
    ;;
  *)
    usage
    [ "$cmd" = help ] || [ "$cmd" = --help ] || exit 2
    ;;
esac
