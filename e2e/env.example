# Copy to e2e/.env (git-ignored) and fill in. Values are passed to the container as-is: no quotes, no `export`.
# From inside the container, a service on the host is http://host.docker.internal:PORT.

# Claude Code: any Anthropic Messages-compatible endpoint.
ANTHROPIC_BASE_URL=https://your-gateway.example
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
# Claude Code's background model; point it at the same model if the endpoint has only one.
ANTHROPIC_DEFAULT_HAIKU_MODEL=
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# Codex: any OpenAI-compatible endpoint. CODEX_WIRE_API is "responses" (default) or "chat".
OPENAI_BASE_URL=https://your-gateway.example/v1
OPENAI_API_KEY=
CODEX_MODEL=
